# Local security build of rustdesk-api v2.7 (branch local-security). Only /app/apimain is rebuilt from this tree;
# resources, admin UI and config come unchanged from the official image.
#   docker build -f Dockerfile.local -t rustdesk-api-local:v2.7-sec1 .
FROM golang:1.23-alpine AS build
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY . .
# upstream ships no go.sum; tidy records checksums for the go.mod versions (verified against sum.golang.org)
RUN go mod tidy && CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags "-s -w" -o /apimain cmd/apimain.go

FROM lejianwen/rustdesk-api:v2.7
COPY --from=build /apimain /app/apimain
